name: an integer literal too large for an int is a float
description: >
  Decimal, hexadecimal and octal literals past PHP_INT_MAX widen to floats, and 1e1000 is INF. Expected output is php 8.4's.
runner:
  flatstack: false
---
<?php
var_dump(9223372036854775807, 9223372036854775808, 0xFFFFFFFFFFFFFFFF, 0x7FFFFFFFFFFFFFFF, 0777777777777777777777, -9223372036854775808, 1e1000, 0xFFFFFFFFFFFFFFFFF, 123456789012345678901234567890, PHP_INT_MAX + 1, (int) '9223372036854775808', 0b0);
---
int(9223372036854775807)
float(9.223372036854776E+18)
float(1.8446744073709552E+19)
int(9223372036854775807)
int(9223372036854775807)
float(-9.223372036854776E+18)
float(INF)
float(2.9514790517935283E+20)
float(1.2345678901234568E+29)
float(9.223372036854776E+18)
int(9223372036854775807)
int(0)
